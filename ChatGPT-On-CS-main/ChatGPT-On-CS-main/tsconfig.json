{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // ===== 严格模式（关键！）=====
    "strict": true,
    "noUncheckedIndexedAccess": true,     // arr[i] 返回 T | undefined
    "noImplicitReturns": true,             // 函数必须有返回值
    "noFallthroughCasesInSwitch": true,    // switch 必须 break

    // ===== 代码质量 =====
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,                 // 禁止隐式 any
    "exactOptionalPropertyTypes": true,    // undefined 必须显式写

    // ===== 路径别名 =====
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"],
      "@renderer/*": ["src/renderer/*"]
    },

    // ===== 输出 =====
    "outDir": "./dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    // ===== Electron =====
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
