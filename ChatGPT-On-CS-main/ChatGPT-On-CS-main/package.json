    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "mini-css-extract-plugin": "^2.7.6",
    "node-addon-api": "^8.9.2",
    "prettier": "^3.9.6",
    "prettier-eslint": "^17.1.2",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "^19.2.8",
    "rimraf": "^6.1.3",
